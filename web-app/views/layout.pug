doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'CityEquip'
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="/style.css")
    
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        a.navbar-brand(href="/") 🏙️ CityEquip
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.me-auto
            li.nav-item
              a.nav-link(href="/") Inicio
            li.nav-item
              a.nav-link(href="/equipments") Equipamientos
          ul.navbar-nav.ms-auto
            if user
              if user.role === 'admin'
                li.nav-item
                  a.nav-link(href="/equipments/new") 📝 Añadir Equipamiento
              li.nav-item
                a.nav-link(href="/account") 👤 #{user.name}
              li.nav-item
                a.nav-link(href="/logout") 🚪 Cerrar Sesión
            else
              li.nav-item
                a.nav-link(href="/register") 📝 Registrarse
              li.nav-item
                a.nav-link(href="/login") 🔑 Iniciar Sesión

    .container.mt-4
      //- Flash messages
      if success && success.length
        each msg in success
          .alert.alert-success.alert-dismissible.fade.show= msg
            button.btn-close(type="button" data-bs-dismiss="alert")
      
      if error && error.length
        each msg in error
          .alert.alert-danger.alert-dismissible.fade.show= msg
            button.btn-close(type="button" data-bs-dismiss="alert")

      block content

    footer.bg-dark.text-light.mt-5.py-3
      .container.text-center
        p.m-0 CityEquip - Equipamientos de Tarragona © 2025

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js")