extends layout

block content
  .row
    .col-12
      nav(aria-label="breadcrumb")
        ol.breadcrumb
          li.breadcrumb-item
            a(href="/") Inicio
          li.breadcrumb-item
            a(href="/account") Mi Cuenta
          li.breadcrumb-item.active Mis Valoraciones

  .row
    .col-12
      .card
        .card-body
          h2.card-title 💬 Mis Valoraciones
          
          if ratings && ratings.length > 0
            p 
              strong Total: 
              | #{ratings.length} valoraciones
              
            each rating in ratings
              .card.mb-3
                .card-body
                  .d-flex.justify-content-between.align-items-start
                    div
                      h5.card-title= rating.equipmentName
                      .mb-2
                        span.badge.bg-warning.text-dark ⭐ #{rating.rating}/5
                      if rating.comment
                        p.card-text= rating.comment
                      p.text-muted.small
                        | Valorado el #{new Date(rating.createdAt).toLocaleDateString('es-ES')} a las #{new Date(rating.createdAt).toLocaleTimeString('es-ES')}
                    
                    .btn-group
                      a.btn.btn-sm.btn-outline-primary(
                        href=`/equipments/${rating.equipmentId}`
                      ) 
                        | 👁️ Ver equipamiento
                      form.d-inline(
                        method="POST" 
                        action=`/equipments/${rating.equipmentId}/rate/delete`
                      )
                        button.btn.btn-sm.btn-outline-danger(
                          type="submit" 
                          onclick="return confirm('¿Eliminar esta valoración?')"
                        ) 
                          | 🗑️ Eliminar
          
          else
            .text-center.py-5
              h4.text-muted 📝 Aún no has realizado valoraciones
              p.mb-4 Explora los equipamientos y comparte tus opiniones con la comunidad
              a.btn.btn-primary.btn-lg(href="/equipments") 
                | 🏢 Explorar equipamientos