extends layout

block content
  .row.justify-content-center
    .col-md-6
      .card
        .card-body
          h2.card-title.text-center 📝 Registrarse
          
          if errors
            .alert.alert-danger
              ul.mb-0
                each error in errors
                  li= error.msg
          
          form(action="/register" method="POST")
            .mb-3
              label.form-label(for="name") Nombre completo
              input.form-control(
                type="text", 
                name="name", 
                id="name", 
                value=body.name || '',
                required
              )
            .mb-3
              label.form-label(for="email") Email
              input.form-control(
                type="email", 
                name="email", 
                id="email", 
                value=body.email || '',
                required
              )
            .mb-3
              label.form-label(for="password") Contraseña
              input.form-control(
                type="password", 
                name="password", 
                id="password", 
                required,
                minlength="6"
              )
            .mb-3
              label.form-label(for="confirmPassword") Confirmar contraseña
              input.form-control(
                type="password", 
                name="confirmPassword", 
                id="confirmPassword", 
                required
              )
            .d-grid
              button.btn.btn-primary.btn-lg(type="submit") Registrarse
            
          .mt-3.text-center
            p ¿Ya tienes cuenta? 
              a(href="/login") Inicia sesión aquí