# Cadena de conexión a MongoDB Atlas (base de datos de usuarios y valoraciones)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cityequip-web
# Secreto de firma de la cookie de sesión
SESSION_SECRET=<cadena-aleatoria-larga>
# Dónde escucha la API REST
API_BASE_URL=http://localhost:3001
# Debe coincidir con API_SECRET_KEY de la API REST
API_SECRET_KEY=<clave-secreta>
PORT=3000
